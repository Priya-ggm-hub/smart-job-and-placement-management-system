              "raw": "{\n  \"name\": \"Cognitive AI Labs\",\n  \"description\": \"Autonomous AI agents & scalable cloud infrastructure solutions.\",\n  \"industry\": \"Artificial Intelligence\",\n  \"location\": \"Bangalore, India\",\n  \"website\": \"https://cognitiveailabs.com\",\n  \"contactEmail\": \"careers@cognitiveailabs.com\"\n}"
