{
  "info": {
    "_postman_id": "8fa19e34-5829-4b67-8db1-c5db611598aa",
    "name": "Smart Job & Placement Management System API",
    "description": "Comprehensive REST API collection for campus placements, student profiles, eligibility evaluation, skill gap recommendations, interview scheduling, bulk student onboarding, and analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Student Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"karan.verma@college.edu\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Karan Verma\",\n  \"phone\": \"+91 9876543299\",\n  \"dateOfBirth\": \"2003-08-15\",\n  \"department\": \"CSE\",\n  \"degree\": \"B.Tech\",\n  \"graduationYear\": 2025,\n  \"cgpa\": 8.65,\n  \"skills\": [\"Java\", \"Spring Boot\", \"SQL\", \"Docker\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Student / Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@placement.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
